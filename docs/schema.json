  "paths": {
    "/chat/api/v1/conversations": {
      "get": {
        "operationId": "chat_api_v1_conversations_list",
        "description": "List the requesting user's conversations, or create one.\n\n**Permissions:** `IsAuthenticated`",
        "parameters": [
          {
            "name": "anchor",
            "required": false,
            "in": "query",
            "description": "Anchor value to paginate from (exclusive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "required": false,
            "in": "query",
            "description": "Pagination direction",
            "schema": {
              "type": "string",
              "enum": [
                "next",
                "prev",
                "center"
              ],
              "default": "next"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of items (default 50, max 200)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "tags": [
          "Chat"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedConversationResponseList"
                }
              }
            },
            "description": ""
          }
        }
      },
      "post": {
        "operationId": "chat_api_v1_conversations_create",
        "description": "List the requesting user's conversations, or create one.\n\n**Permissions:** `IsAuthenticated`",
        "tags": [
          "Chat"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversationRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversationRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateConversationRequest"
              }
            }
          }
        },
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationResponse"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/chat/api/v1/conversations/{conversation_id}": {
      "get": {
        "operationId": "chat_api_v1_conversations_retrieve",
