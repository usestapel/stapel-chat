    "/chat/api/v1/conversations/{conversation_id}/messages/{message_id}": {
      "patch": {
        "operationId": "chat_api_v1_conversations_messages_partial_update",
        "description": "Edit or delete one message. Author only.\n\nThe HTTP twin of the socket's ``edit`` / ``delete`` frames — same service\ncalls, same emits, same fan-out. It exists so a client that has just\nrehydrated over REST is not obliged to open a socket to correct a typo,\nnot because REST is the intended path: the socket is.\n\n``DELETE`` leaves a **tombstone** and answers ``200`` with the stripped\nmessage, not ``204``. The body is the point — the caller (and every other\nsubscriber, over the socket) is handed the exact row shape that says \"this\nid is now empty\", which is what a local cache purges against.\n\n**Permissions:** `IsAuthenticated`",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "message_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": [
          "Chat"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchedEditMessageRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PatchedEditMessageRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PatchedEditMessageRequest"
              }
            }
          }
        },
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": ""
          }
        }
      },
      "delete": {
        "operationId": "chat_api_v1_conversations_messages_destroy",
        "description": "Edit or delete one message. Author only.\n\nThe HTTP twin of the socket's ``edit`` / ``delete`` frames — same service\ncalls, same emits, same fan-out. It exists so a client that has just\nrehydrated over REST is not obliged to open a socket to correct a typo,\nnot because REST is the intended path: the socket is.\n\n``DELETE`` leaves a **tombstone** and answers ``200`` with the stripped\nmessage, not ``204``. The body is the point — the caller (and every other\nsubscriber, over the socket) is handed the exact row shape that says \"this\nid is now empty\", which is what a local cache purges against.\n\n**Permissions:** `IsAuthenticated`",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "message_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": [
          "Chat"
        ],
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/chat/api/v1/conversations/{conversation_id}/read": {
      "post": {
        "operationId": "chat_api_v1_conversations_read_create",
        "description": "Advance the requesting user's read and delivery markers.\n\nBoth markers are durable rows and both fan out a live receipt when they\nmove — ``chat.read`` / ``chat.delivered`` on the conversation stream. The\nreceipt is a Signal, not an event: the truth is on the participant row and\ncomes back with the conversation, so nobody who was offline is owed a\nreplay of a tick mark.\n\n**Permissions:** `IsAuthenticated`",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": [
          "Chat"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkReadRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/MarkReadRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/MarkReadRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "JWTCookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "No response body"
          }
        }
      }
    },
