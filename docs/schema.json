  },
  "components": {
    "schemas": {
      "ActivityRequest": {
        "type": "object",
        "description": "Announce what the caller is doing right now.",
        "properties": {
          "state": {
            "type": "string",
            "description": "A name from the open activity registry — ``typing``,"
          }
        },
        "required": [
          "state"
        ]
      },
      "AttachmentResponse": {
        "type": "object",
        "description": "One attachment, carrying everything a bubble needs to paint on first\nframe — no second round trip, and no reflow when the asset lands.\n\nEvery field is present on every attachment, ``null`` where it does not\napply or the CDN has not produced it yet; which of them a given ``type``\nis expected to populate is declared by the attachment-type registry\n(:mod:`stapel_chat.attachments`), which is open — a sticker is a settings\nline, not a release.\n\nThe names are **stapel-cdn's** (`cdn.describe`), because they name the\nsame things and two vocabularies for one thing is how a seam rots.",
        "properties": {
          "key": {
            "type": "string",
            "description": "Opaque CDN ref (``<type>/<hash>``). The only field this module"
          },
          "type": {
            "type": "string",
            "description": "Registry type, and the CDN's media ``kind``: ``image`` / ``gif``"
          },
          "mime": {
            "type": "string",
            "nullable": true,
            "description": "Content type"
          },
          "bytes": {
            "type": "integer",
            "nullable": true,
            "description": "Byte size of the original"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Original filename (documents)"
          },
          "ext": {
            "type": "string",
            "nullable": true,
            "description": "Lowercase extension (documents)"
          },
          "width": {
            "type": "integer",
            "nullable": true,
            "description": "Pixel width (image/gif/video)"
          },
          "height": {
            "type": "integer",
            "nullable": true,
            "description": "Pixel height (image/gif/video)"
          },
          "aspect": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "``width / height`` — the number that reserves the box before"
          },
          "square": {
            "type": "boolean",
            "nullable": true,
            "description": "Whether the asset is square within a pixel"
          },
          "animated": {
            "type": "boolean",
            "nullable": true,
            "description": "Whether it moves, so a UI offers a play affordance rather"
          },
          "duration_ms": {
            "type": "integer",
            "nullable": true,
            "description": "Playback length (audio/video). ``null`` means"
          },
          "preview_b64": {
            "type": "string",
            "nullable": true,
            "description": "The inline placeholder as a ``data:image/webp;base64,…``"
          },
          "preview_kind": {
            "type": "string",
            "nullable": true,
            "description": "What ``preview_b64`` depicts — ``blur`` (a 16px LQIP),"
          },
          "poster_url": {
            "type": "string",
            "nullable": true,
            "description": "A video's full poster image, present only once the poster"
          },
          "meta_status": {
            "type": "string",
            "description": "``ok`` / ``partial`` / ``missing``"
          },
          "meta_reason": {
            "type": "string",
            "nullable": true,
            "description": "Why, whenever the status is not ``ok``"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            },
            "description": "Per-tier CDN geometry ``[{tier, branch, url, width,"
          }
        },
        "required": [
          "key",
          "type"
        ]
      },
      "ConversationResponse": {
        "type": "object",
        "description": "A conversation (thread).",
        "properties": {
          "id": {
            "type": "string",
            "description": "Conversation id (UUID)"
          },
          "kind": {
            "type": "string",
            "description": "``direct`` / ``group`` / ``support``"
          },
          "scope_key": {
            "type": "string",
            "description": "Opaque host scope (workspace/org/tenant)"
          },
          "support_status": {
            "type": "string",
            "description": "``open`` / ``pending`` / ``resolved`` (empty for"
          },
          "last_seq": {
            "type": "integer",
            "description": "High-water mark of message seq in this conversation"
          },
          "unread_count": {
            "type": "integer",
            "description": "Messages newer than the requesting user's read marker,"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last-activity time"
          },
          "stream_key": {
            "type": "string",
            "description": "The realtime stream this conversation lives on"
          },
          "socket_path": {
            "type": "string",
            "description": "Where to open it (``ws/chat/<id>``), relative to the"
          },
          "assigned_operator_id": {
            "type": "string",
            "nullable": true,
            "description": "Assigned support operator, if any"
          },
          "subject": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SubjectResponse"
              }
            ],
            "nullable": true,
            "description": "What the thread is about, with its rendered card inlined —"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantResponse"
            },
            "description": "The conversation's participants"
          }
        },
        "required": [
          "created_at",
          "id",
          "kind",
          "last_seq",
          "scope_key",
          "support_status",
          "unread_count",
          "updated_at"
        ]
      },
      "CreateConversationRequest": {
        "type": "object",
        "description": "Create a conversation.",
        "properties": {
          "kind": {
            "type": "string",
            "description": "``direct`` / ``group`` / ``support``. For ``direct`` supply"
          },
          "participant_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Other participants to add (the requesting user is"
          },
          "subject_type": {
            "type": "string",
            "description": "What this thread is about, by registered type. Supply"
          },
          "subject_key": {
            "type": "string",
            "description": "The opaque key within that type. Never parsed here"
          },
          "scope_key": {
            "type": "string",
            "description": "Ignored — the scope is resolved server-side from the"
          }
        }
      },
      "MarkReadRequest": {
        "type": "object",
        "description": "Advance the requesting user's read/delivery markers.",
        "properties": {
          "upto_seq": {
            "type": "integer",
            "description": "seq of the newest message now considered read"
          },
          "delivered_upto_seq": {
            "type": "integer",
            "description": "seq of the newest message the client holds. Omit"
          }
        },
        "required": [
          "upto_seq"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "description": "A single message — or its tombstone.\n\nA deleted message is still returned: same ``id``, same ``seq``, empty\n``body``, empty ``attachments``, ``deleted=true``. That is deliberate, and\nit is what a client cache needs — an id that stops arriving is an id\nnobody can purge.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Message id (UUID)"
          },
          "conversation_id": {
            "type": "string",
            "description": "Owning conversation id"
          },
          "seq": {
            "type": "integer",
            "description": "Position in the thread. Immutable — sort by this"
          },
          "rev_seq": {
            "type": "integer",
            "description": "Position in the conversation's revision journal; changes on"
          },
          "kind": {
            "type": "string",
            "description": "``text`` or ``system``"
          },
          "body": {
            "type": "string",
            "description": "Message text (empty when only attachments are present, and"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation time (tz-aware ISO 8601)"
          },
          "sender_id": {
            "type": "string",
            "nullable": true,
            "description": "Author's user id (null for system messages)"
          },
          "reply_to": {
            "type": "string",
            "nullable": true,
            "description": "Quoted message id, if any"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentResponse"
            },
            "description": "Render descriptors (see :class:`AttachmentResponse`)"
          },
          "client_msg_id": {
            "type": "string",
            "nullable": true,
            "description": "The sender's own idempotency key, echoed back so an"
          },
          "edited": {
            "type": "boolean",
            "description": "Whether the body was changed after posting"
          },
          "edited_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When it was changed (null if never)"
          },
          "deleted": {
            "type": "boolean",
            "description": "Whether this is a tombstone"
          },
          "deleted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "When it was deleted (null if live)"
          }
        },
        "required": [
          "body",
          "conversation_id",
          "created_at",
          "id",
          "kind",
          "rev_seq",
          "seq"
        ]
      },
