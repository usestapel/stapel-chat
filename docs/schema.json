      "PatchedEditMessageRequest": {
        "type": "object",
        "description": "Replace a message's body. Author only.",
        "properties": {
          "body": {
            "type": "string",
            "description": "The new text. An edit cannot empty a message — deleting is the"
          }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "description": "Post a message.\n\nThere is deliberately **no draft**. A compose box is client state; the\nserver has one verb, and it is \"send\". A server-side draft concept would\nput a save round trip between the Enter key and the message, which is\nprecisely the thing that must not exist.",
        "properties": {
          "body": {
            "type": "string",
            "description": "Message text (required unless attachments are supplied)"
          },
          "attachments": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "key",
                    "type"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "description": "Attachment type from the OPEN registry — image / gif / video / voice / file out of the box, plus whatever STAPEL_CHAT['ATTACHMENT_TYPES'] adds."
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "string",
                  "description": "Bare CDN ref (pre-0.3 form)."
                }
              ]
            }
          },
          "reply_to": {
            "type": "string",
            "nullable": true,
            "description": "Message id being replied to (must be in this conversation)"
          },
          "client_msg_id": {
            "type": "string",
            "description": "Sender-generated idempotency key. Retrying the same"
          }
        }
      },
      "SubjectResponse": {
        "type": "object",
        "description": "What a conversation is about, and the card somebody else rendered.\n\nThe ``(type, key)`` pair is this module's; the ``card`` is not — it is\nwhatever the subject type's ``card_function`` answered, passed through\nuntouched. Chat does not know what a listing is and never will, so it\nstores a name and asks the owner.",
        "properties": {
          "type": {
            "type": "string",
            "description": "Registered subject type (``listing``, …)"
          },
          "key": {
            "type": "string",
            "description": "Opaque key within that type"
          },
          "card": {
            "type": "object",
            "additionalProperties": {},
            "nullable": true,
            "description": "The provider's card, or ``null`` when there is none to show"
          },
          "meta_status": {
            "type": "string",
            "description": "``ok`` / ``partial`` / ``missing`` — the attachment"
          },
          "meta_reason": {
            "type": "string",
            "nullable": true,
            "description": "``subject_type_unregistered`` /"
          }
        },
        "required": [
          "key",
          "type"
        ]
      }
    },
