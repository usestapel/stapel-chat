{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chat.message.edited",
  "description": "A message's body was replaced by its author. The row carries a FRESH rev_seq, which is what makes the edit reachable by a client that was offline when it happened: anchored on seq it would sit behind a cursor the client had already acknowledged. `edited_at` is non-null on every instance of this event.",
  "type": "object",
  "required": [
    "message_id",
    "conversation_id",
    "seq",
    "rev_seq",
    "edited_at"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_kind": {
      "type": "string",
      "enum": [
        "direct",
        "group",
        "support"
      ]
    },
    "scope_key": {
      "type": "string"
    },
    "sender_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "rev_seq": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "system"
      ]
    },
    "body": {
      "type": "string"
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "client_msg_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "edited": {
      "type": "boolean"
    },
    "edited_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deleted": {
      "type": "boolean"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "attachments": {
      "type": "array",
      "description": "Render descriptors. `type` is an OPEN registry sharing one vocabulary with stapel-cdn's media kinds, not a closed enum.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Opaque CDN ref, <type>/<hash>"
          },
          "type": {
            "type": "string",
            "description": "Attachment type — an OPEN registry, and the same vocabulary as stapel-cdn's media kinds (image/gif/video/audio/file out of the box, plus whatever the host registered in both)."
          },
          "mime": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "ext": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          },
          "aspect": {
            "type": [
              "number",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Playback length. null means UNMEASURED, never zero — a zero-length voice message and an unmeasured one are different facts."
          },
          "preview_b64": {
            "type": [
              "string",
              "null"
            ],
            "description": "Inline placeholder as a data:image/webp;base64,... URI, bounded by the CDN's byte budget."
          },
          "variants": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object"
            }
          },
          "square": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "animated": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "preview_kind": {
            "type": [
              "string",
              "null"
            ],
            "description": "What preview_b64 depicts: blur | poster | waveform | null. A separate field on purpose — it follows from `type`, so it is known BEFORE any preview exists and a client can reserve the right-shaped placeholder immediately."
          },
          "poster_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "A video's full poster, present only once it actually exists — never derived from the hash."
          },
          "meta_status": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "missing"
            ]
          },
          "meta_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Named reason whenever meta_status is not ok (ffmpeg_missing, not_generated, preview_over_budget, unknown_ref, ...). A degraded attachment stays renderable."
          }
        },
        "additionalProperties": true,
        "description": "Render descriptors from stapel-cdn's `cdn.describe_many`, denormalized once at send time. Field names are the CDN's."
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
